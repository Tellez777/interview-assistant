# Copia este archivo a .env y completa tus valores reales. .env nunca se sube.

# --- LLM ---
# Proveedor por defecto para generar el banco de respuestas y evaluar en Practice Mode.
# "anthropic" | "openai_compat"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Alternativa: API real de OpenAI, o un gateway compatible (IA Engine, Groq, etc.).
# Para OpenAI real: deja OPENAI_COMPAT_BASE_URL vacío y pon tu API key normal
# de OpenAI en OPENAI_COMPAT_API_KEY, con LLM_PROVIDER=openai_compat.
# Para un gateway propio: pon su URL en OPENAI_COMPAT_BASE_URL (la key puede
# no aplicar, según cómo esté configurado tu gateway).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-5.4-mini
# Modelo más grande para Live Mode cuando detecta una pregunta técnica/de
# código (escribir una query, explicar un algoritmo, etc.). Vacío = usa
# el modelo de arriba para todo.
OPENAI_COMPAT_TECHNICAL_MODEL=gpt-5.4

# --- ASR ---
# "cuda" si el benchmark de check_env.py lo confirma, si no "cpu".
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=int8_float16
ASR_MODEL=small.en
ASR_REALTIME_MODEL=tiny.en

# --- App ---
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=./data
